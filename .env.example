DATABASE_URL=<database_url: string>
PORT=<port_number: number (e.g., 3000)>
JWT_SECRET=<jwt_secret: string>
REFRESH_SECRET=<refresh_secret: string>
RESEND_API_KEY=<resend_api_key: string>
MAIL_FROM=<mail_from: string (e.g., "no-reply@your-domain.com")>
FRONTEND_URL=<frontend_url: string (e.g., "http://localhost:5173")>
NODE_ENV=<node_env: string (e.g., "development", "production")>
